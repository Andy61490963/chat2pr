# 正式機密請由 npm run setup 的本機設定頁輸入，不要提交。
# 請執行 npm run init 產生 .env 的隨機 POSTGRES_PASSWORD。
# 正式資料庫僅供 Docker 內部連線；本機開發另設 DATABASE_URL。
# Docker 部署只從 .env 讀取 POSTGRES_PASSWORD 與 ADMIN_GITHUB_ID；
# 其餘變數由 compose.yaml 固定，下列值只用於不經容器的本機開發（npm run dev）。
PORT=4310
AGENTFLOW_INSTANCE=production
HOST=127.0.0.1
PUBLIC_URL=http://localhost:4310
# 看板擁有者的 GitHub 數字 ID（不是帳號名稱）；查詢：gh api users/帳號 --jq .id
ADMIN_GITHUB_ID=
SECRETS_FILE=.local/secrets.json
DATA_DIR=.local/data
RUNNER_URL=http://127.0.0.1:4312
# 可信訂閱代理只在本機監聽；工作容器只能經專用轉送器推論。
RUNNER_LISTEN_PORT=4312
SUBSCRIPTION_BROKER_PORT=4313
SUBSCRIPTION_RELAY_URL=http://subscription-relay:4313
