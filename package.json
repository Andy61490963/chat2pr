{
  "name": "line-agentflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "LINE 群組需求審核、Codex 派工與人工合併看板",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "services": "node scripts/start-windows.mjs",
    "install:startup": "node scripts/install-startup.mjs",
    "codex:login": "node scripts/codex-login.mjs",
    "init": "tsx scripts/init.ts",
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "tsx server/main.ts",
    "setup": "tsx server/setup.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx server/migrate.ts",
    "backup": "tsx scripts/backup.ts",
    "runner": "tsx server/runner-main.ts",
    "tunnel": "tsx scripts/tunnel.ts",
    "deploy": "node scripts/deploy.mjs",
    "smoke": "node scripts/deploy.mjs --smoke-only",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.9",
    "@fontsource-variable/inter": "5.3.0",
    "@ngrok/ngrok": "^1.7.0",
    "@octokit/auth-app": "^8.0.2",
    "@octokit/rest": "^22.0.1",
    "@openai/codex-sdk": "^0.166.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dockerode": "^5.0.1",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.3.0",
    "openai": "^6.0.0",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "radix-ui": "1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.5",
    "ssh2": "^1.17.0",
    "tailwind-merge": "3.7.0",
    "tar-stream": "^3.2.2",
    "tedious": "^20.3.8",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/dockerode": "^3.3.45",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.6",
    "@types/tar-stream": "^3.1.5",
    "@vitejs/plugin-react": "^5.1.0",
    "postcss": "8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.8"
  }
}
